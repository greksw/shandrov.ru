---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: string;
}

const {
  title,
  description,
  lang = "en",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b0f14"
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>{title}</title>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
