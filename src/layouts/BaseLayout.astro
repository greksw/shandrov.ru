---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "ru" | "en";
  image?: string;
}

const {
  title,
  description,
  lang = "en",
  image = "/images/social/shandrov-og.png",
} = Astro.props;

const pathname = Astro.url.pathname;

const ruPath =
  pathname === "/en" || pathname === "/en/"
    ? "/"
    : pathname.startsWith("/en/")
      ? pathname.slice(3)
      : pathname;

const enPath =
  pathname === "/"
    ? "/en/"
    : pathname === "/en" || pathname.startsWith("/en/")
      ? pathname
      : `/en${pathname}`;

const canonical = new URL(pathname, Astro.site);
const ruUrl = new URL(ruPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);
const socialImage = new URL(image, Astro.site);

/*
 * shandrov.ru uses Russian as the default/root locale.
 * x-default therefore points to the Russian counterpart.
 */
const defaultUrl = ruUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b0f14"
    />

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:site_name"
      content="Tudor Shandrov"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonical}
    />

    <meta
      property="og:image"
      content={socialImage}
    />

    <meta
      property="og:image:type"
      content="image/png"
    />

    <meta
      property="og:image:width"
      content="1200"
    />

    <meta
      property="og:image:height"
      content="630"
    />

    <meta
      property="og:image:alt"
      content="Tudor Shandrov — Infrastructure Engineer"
    />

    <meta
      property="og:locale"
      content={lang === "ru" ? "ru_RU" : "en_US"}
    />

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImage}
    />

    <meta
      name="twitter:image:alt"
      content="Tudor Shandrov — Infrastructure Engineer"
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <link
      rel="alternate"
      hreflang="ru"
      href={ruUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={enUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={defaultUrl}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>{title}</title>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
