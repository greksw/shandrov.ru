---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: "ru" | "en";
}

const {
  title,
  description,
  lang = "en",
} = Astro.props;

const pathname = Astro.url.pathname;

const ruPath =
  pathname === "/en" || pathname === "/en/"
    ? "/"
    : pathname.startsWith("/en/")
      ? pathname.slice(3)
      : pathname;

const enPath =
  pathname === "/"
    ? "/en/"
    : pathname === "/en" || pathname.startsWith("/en/")
      ? pathname
      : `/en${pathname}`;

const canonical = new URL(pathname, Astro.site);
const ruUrl = new URL(ruPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);

/*
 * shandrov.ru uses Russian as the default/root locale.
 * x-default therefore points to the Russian counterpart.
 */
const defaultUrl = ruUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="description"
      content={description}
    />

    <meta
      name="theme-color"
      content="#0b0f14"
    />

    <link
      rel="canonical"
      href={canonical}
    />

    <link
      rel="alternate"
      hreflang="ru"
      href={ruUrl}
    />

    <link
      rel="alternate"
      hreflang="en"
      href={enUrl}
    />

    <link
      rel="alternate"
      hreflang="x-default"
      href={defaultUrl}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>{title}</title>

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
