---
import "../styles/global.css";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta
      name="robots"
      content="noindex, nofollow"
    />

    <meta
      name="theme-color"
      content="#0b0f14"
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <link
      rel="icon"
      href="/favicon.ico"
    />

    <title>404 — Tudor Shandrov</title>
  </head>

  <body>
    <main class="not-found">
      <div class="not-found-inner">
        <span class="code">404</span>

        <h1>Страница не найдена.</h1>

        <p>
          Запрошенный адрес не существует или страница была перемещена.
        </p>

        <p class="en">
          The requested page does not exist or has been moved.
        </p>

        <div class="actions">
          <a href="/">
            ← На главную
          </a>

          <a href="/en/">
            English version →
          </a>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 40px 24px;
    background:
      linear-gradient(
        rgba(35, 52, 67, 0.16) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(35, 52, 67, 0.16) 1px,
        transparent 1px
      ),
      #0b0f14;
    background-size: 80px 80px;
  }

  .not-found-inner {
    width: min(760px, 100%);
  }

  .code {
    display: block;
    margin-bottom: 28px;
    color: #5792ff;
    font-family: monospace;
    font-size: 14px;
    letter-spacing: 0.18em;
  }

  h1 {
    max-width: 700px;
    margin: 0 0 30px;
    color: #f3f6f8;
    font-size: clamp(42px, 7vw, 78px);
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 620px;
    margin: 0 0 12px;
    color: #9fb5c6;
    font-size: 18px;
    line-height: 1.7;
  }

  .en {
    color: #72899a;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 48px;
  }

  .actions a {
    color: #5792ff;
    font-weight: 700;
    text-decoration: none;
  }

  .actions a:hover {
    text-decoration: underline;
  }
</style>
