---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const expertise = [
  {
    title: "Linux & Platform",
    text: "Production Linux infrastructure, system services, hardening, troubleshooting and lifecycle management.",
    tags: ["Debian", "AlmaLinux", "Ansible", "Bash"],
  },
  {
    title: "Virtualization & Storage",
    text: "Highly available virtualization platforms, distributed storage and backup infrastructure.",
    tags: ["Proxmox VE", "Ceph", "PBS", "TrueNAS"],
  },
  {
    title: "Networking",
    text: "Multi-site networks, segmentation, routing, VPN connectivity and resilient Internet access.",
    tags: ["MikroTik", "VLAN", "WireGuard", "IPsec"],
  },
  {
    title: "Observability",
    text: "Metrics, logs and alerting built around infrastructure visibility rather than isolated monitoring checks.",
    tags: ["Prometheus", "Grafana", "Loki", "Zabbix"],
  },
  {
    title: "Security",
    text: "Security monitoring, system hardening, access control and practical infrastructure risk reduction.",
    tags: ["Wazuh", "SELinux", "nftables", "PKI"],
  },
  {
    title: "Infrastructure Operations",
    text: "Architecture, migrations, incident response, documentation and technical team coordination.",
    tags: ["HA", "Backup", "DR", "Runbooks"],
  },
];

const projects = [
  {
    number: "01",
    title: "Multi-site Infrastructure",
    description:
      "Architecture and operation of infrastructure spanning multiple locations: segmentation, secure inter-site connectivity, routing and centralized services.",
    stack: "Networking · Linux · VPN · Security",
  },
  {
    number: "02",
    title: "Proxmox & Ceph Platform",
    description:
      "Operation and development of clustered virtualization platforms with distributed storage, high availability and dedicated backup infrastructure.",
    stack: "Proxmox VE · Ceph · PBS · HA",
  },
  {
    number: "03",
    title: "Observability Platform",
    description:
      "Centralized observability for servers, virtualization and network infrastructure using metrics, dashboards, logs and actionable alerting.",
    stack: "Prometheus · Grafana · Loki · Zabbix",
  },
  {
    number: "04",
    title: "Infrastructure Deployment",
    description:
      "End-to-end delivery of new IT environments: requirements, equipment planning, networking, virtualization, identity services, storage and migration.",
    stack: "Architecture · AD · Network · Virtualization",
    href: "/en/projects/infrastructure-deployment/",
  },
];
---

<BaseLayout
  title="Tudor Shandrov — Infrastructure Engineer"
  description="Tudor Shandrov — Infrastructure Engineer and Infrastructure Lead. Linux, Proxmox, networking, observability, security and automation."
  lang="en"
>
<div class="page-glow page-glow-one"></div>
    <div class="page-glow page-glow-two"></div>
    <SiteHeader lang="en" />

<main>
      <section class="hero container">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="status-dot"></span>
            Infrastructure Engineer / Infrastructure Lead
          </div>

          <h1>
            Building reliable infrastructure
            <span>for production.</span>
          </h1>

          <p class="hero-lead">
            Designing, modernizing and operating production infrastructure
            across Linux, virtualization, networks, observability and security.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projects">
              View selected projects
            </a>

            <a class="button button-secondary" href="#about">
              About me
            </a>
          </div>

          <div class="hero-stack" aria-label="Primary technologies">
            <span>Linux</span>
            <span>Proxmox</span>
            <span>Ceph</span>
            <span>Networking</span>
            <span>Prometheus</span>
            <span>Wazuh</span>
          </div>
        </div>

        <div class="hero-panel" aria-label="Infrastructure profile">
          <div class="panel-header">
            <div>
              <span class="panel-label">PROFILE</span>
              <strong>Infrastructure / Operations</strong>
            </div>

            <span class="panel-state">PRODUCTION</span>
          </div>

          <div class="topology">
            <div class="topology-line line-a"></div>
            <div class="topology-line line-b"></div>
            <div class="topology-line line-c"></div>

            <div class="node node-core">
              <span class="node-light"></span>
              CORE
            </div>

            <div class="node node-linux">
              <span class="node-light"></span>
              LINUX
            </div>

            <div class="node node-pve">
              <span class="node-light"></span>
              PVE
            </div>

            <div class="node node-monitoring">
              <span class="node-light"></span>
              OBSERVABILITY
            </div>

            <div class="node node-security">
              <span class="node-light"></span>
              SECURITY
            </div>
          </div>

          <div class="panel-metrics">
            <div>
              <span>Experience</span>
              <strong>20+ years</strong>
            </div>

            <div>
              <span>Environment</span>
              <strong>Multi-site</strong>
            </div>

            <div>
              <span>Focus</span>
              <strong>Reliability</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="metrics-section">
        <div class="container metrics-grid">
          <div class="metric">
            <strong>20+</strong>
            <span>years in IT</span>
          </div>

          <div class="metric">
            <strong>40+</strong>
            <span>production servers</span>
          </div>

          <div class="metric">
            <strong>150+</strong>
            <span>users supported</span>
          </div>

          <div class="metric">
            <strong>Multi-site</strong>
            <span>infrastructure scope</span>
          </div>
        </div>
      </section>

      <section id="expertise" class="section container">
        <div class="section-heading">
          <div>
            <span class="section-index">01 / EXPERTISE</span>
            <h2>Infrastructure as a system,<br />not a set of technologies.</h2>
          </div>

          <p>
            My focus is the interaction between compute, storage, networks,
            monitoring, security and operations — and what happens when
            individual components fail.
          </p>
        </div>

        <div class="expertise-grid">
          {
            expertise.map((item) => (
              <article class="expertise-card">
                <div class="card-top">
                  <div class="card-icon">
                    <span></span>
                  </div>

                </div>

                <h3>{item.title}</h3>
                <p>{item.text}</p>

                <div class="tags">
                  {item.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="projects" class="section projects-section">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="section-index">02 / SELECTED WORK</span>
              <h2>Engineering decisions<br />with operational consequences.</h2>
            </div>

            <p>
              Selected infrastructure areas based on real production work.
              Detailed case studies will be added without exposing client
              networks or confidential data.
            </p>
          </div>

          <div class="project-list">
            {
              projects.map((project) => (
                <article class="project">
                  <span class="project-number">{project.number}</span>

                  <div class="project-content">
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <span class="project-stack">{project.stack}</span>

                    {
                      project.href && (
                        <a class="project-case-link" href={project.href}>
                          View case study <span aria-hidden="true">↗</span>
                        </a>
                      )
                    }
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="section container about-section">
        <div class="about-card">
          <div class="about-copy">
            <span class="section-index">03 / ABOUT</span>

            <h2>
              From troubleshooting individual systems
              to designing the infrastructure around them.
            </h2>

            <p>
              I work at the intersection of hands-on engineering and
              infrastructure ownership: architecture, implementation,
              production support, incident response, migrations,
              documentation and team coordination.
            </p>

            <p>
              My strongest area is heterogeneous infrastructure where Linux,
              virtualization, networking, storage and security have to work
              together as one operational system.
            </p>
          </div>

          <div class="about-side">
            <div class="about-field">
              <span>Role</span>
              <strong>Infrastructure Engineer / Lead</strong>
            </div>

            <div class="about-field">
              <span>Primary focus</span>
              <strong>Production infrastructure</strong>
            </div>

            <div class="about-field">
              <span>Working style</span>
              <strong>Architecture → implementation → operations</strong>
            </div>

            <div class="about-field">
              <span>Technical notes</span>
              <a href="https://runer.su" target="_blank" rel="noreferrer">
                Runer's Lab — Infrastructure Notes ↗
              </a>
            </div>
          </div>
        </div>
      </section>

      <section class="contact-section">
        <div class="container contact-inner">
          <div>
            <span class="section-index">04 / CONTACT</span>
            <h2>Infrastructure engineering — from architecture to operations.</h2>
          </div>

          <div class="contact-actions">
            <a
              class="button button-primary"
              href="https://github.com/greksw"
              target="_blank"
              rel="noreferrer"
            >
              GitHub profile
            </a>

            <a
              class="button button-secondary"
              href="https://runer.su"
              target="_blank"
              rel="noreferrer"
            >
              Technical notes
            </a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter lang="en" />

<style is:global>
      :root {
        color-scheme: dark;

        --bg: #0b0f14;
        --bg-soft: #10161d;
        --surface: #121920;
        --surface-hover: #151e27;
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.14);

        --text: #f2f5f7;
        --muted: #9aa7b4;
        --muted-strong: #c1cad3;

        --blue: #5b8cff;
        --blue-soft: rgba(91, 140, 255, 0.12);
        --cyan: #52d3c5;

        --container: 1180px;
        --radius: 18px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        background: var(--bg);
      }

      body {
        margin: 0;
        min-width: 320px;
        overflow-x: hidden;
        background:
          linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
          var(--bg);
        background-size: 48px 48px;

        color: var(--text);

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(calc(100% - 48px), var(--container));
        margin-inline: auto;
      }

      .page-glow {
        position: fixed;
        z-index: -1;
        width: 520px;
        height: 520px;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(130px);
        opacity: 0.08;
      }

      .page-glow-one {
        top: -250px;
        right: -160px;
        background: var(--blue);
      }

      .page-glow-two {
        top: 650px;
        left: -350px;
        background: var(--cyan);
      }

            .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(390px, 0.9fr);
        gap: 80px;
        align-items: center;
        min-height: 700px;
        padding-block: 96px;
      }

      .eyebrow {
        display: flex;
        gap: 10px;
        align-items: center;
        margin-bottom: 28px;
        color: var(--muted-strong);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--cyan);
        box-shadow: 0 0 0 5px rgba(82, 211, 197, 0.08);
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 720px;
        margin-bottom: 28px;
        font-size: clamp(48px, 6vw, 76px);
        line-height: 0.99;
        letter-spacing: -0.055em;
      }

      h1 span {
        display: block;
        color: var(--muted);
        font-weight: 500;
      }

      .hero-lead {
        max-width: 640px;
        margin-bottom: 34px;
        color: var(--muted-strong);
        font-size: 19px;
        line-height: 1.65;
      }

      .hero-actions,
      .contact-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
      }

      .button {
        display: inline-flex;
        min-height: 46px;
        align-items: center;
        justify-content: center;
        padding: 0 19px;
        border: 1px solid var(--border-strong);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        transition:
          transform 160ms ease,
          border-color 160ms ease,
          background 160ms ease;
      }

      .button:hover {
        transform: translateY(-1px);
      }

      .button-primary {
        border-color: transparent;
        background: var(--blue);
        color: white;
      }

      .button-primary:hover {
        background: #709cff;
      }

      .button-secondary {
        background: rgba(255, 255, 255, 0.025);
      }

      .button-secondary:hover {
        border-color: rgba(255, 255, 255, 0.22);
        background: rgba(255, 255, 255, 0.05);
      }

      .hero-stack {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
        margin-top: 40px;
      }

      .hero-stack span,
      .tags span {
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.018);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        letter-spacing: 0.04em;
      }

      .hero-stack span {
        padding: 7px 10px;
      }

      .hero-panel {
        position: relative;
        overflow: hidden;
        min-height: 465px;
        border: 1px solid var(--border-strong);
        border-radius: 24px;
        background:
          linear-gradient(
            145deg,
            rgba(255, 255, 255, 0.045),
            rgba(255, 255, 255, 0.012)
          ),
          var(--surface);
        box-shadow: 0 40px 120px rgba(0, 0, 0, 0.32);
      }

      .hero-panel::before {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
        background-size: 32px 32px;
        content: "";
        mask-image: linear-gradient(to bottom, black, transparent 88%);
      }

      .panel-header {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 24px;
        border-bottom: 1px solid var(--border);
      }

      .panel-header > div {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .panel-label,
      .panel-state {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 0.12em;
      }

      .panel-label {
        color: var(--muted);
      }

      .panel-header strong {
        font-size: 13px;
      }

      .panel-state {
        padding: 6px 8px;
        border: 1px solid rgba(82, 211, 197, 0.26);
        border-radius: 6px;
        color: var(--cyan);
        background: rgba(82, 211, 197, 0.06);
      }

      .topology {
        position: relative;
        z-index: 2;
        height: 280px;
      }

      .node {
        position: absolute;
        display: flex;
        gap: 8px;
        align-items: center;
        padding: 9px 11px;
        border: 1px solid var(--border-strong);
        border-radius: 7px;
        background: rgba(11, 15, 20, 0.88);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 9px;
        letter-spacing: 0.08em;
      }

      .node-light {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--cyan);
        box-shadow: 0 0 10px rgba(82, 211, 197, 0.55);
      }

      .node-core {
        top: 112px;
        left: calc(50% - 34px);
      }

      .node-linux {
        top: 45px;
        left: 34px;
      }

      .node-pve {
        top: 44px;
        right: 38px;
      }

      .node-monitoring {
        bottom: 38px;
        left: 32px;
      }

      .node-security {
        right: 30px;
        bottom: 36px;
      }

      .topology-line {
        position: absolute;
        z-index: -1;
        background: linear-gradient(
          90deg,
          transparent,
          rgba(91, 140, 255, 0.5),
          transparent
        );
        transform-origin: center;
        height: 1px;
      }

      .line-a {
        top: 106px;
        left: 92px;
        width: 260px;
        transform: rotate(15deg);
      }

      .line-b {
        top: 176px;
        left: 86px;
        width: 280px;
        transform: rotate(-17deg);
      }

      .line-c {
        top: 140px;
        left: 146px;
        width: 190px;
        transform: rotate(90deg);
      }

      .panel-metrics {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--border);
      }

      .panel-metrics > div {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 18px;
        border-right: 1px solid var(--border);
      }

      .panel-metrics > div:last-child {
        border-right: 0;
      }

      .panel-metrics span {
        color: var(--muted);
        font-size: 10px;
      }

      .panel-metrics strong {
        font-size: 12px;
      }

      .metrics-section {
        border-block: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.012);
      }

      .metrics-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .metric {
        display: flex;
        min-height: 148px;
        flex-direction: column;
        justify-content: center;
        padding: 30px 34px;
        border-right: 1px solid var(--border);
      }

      .metric:first-child {
        border-left: 1px solid var(--border);
      }

      .metric strong {
        margin-bottom: 6px;
        font-size: 28px;
        letter-spacing: -0.04em;
      }

      .metric span {
        color: var(--muted);
        font-size: 12px;
      }

      .section {
        padding-block: 100px;
      }

      section[id] {
        scroll-margin-top: 100px;
      }

      .section-heading {
        display: grid;
        grid-template-columns: 1.25fr 0.75fr;
        gap: 80px;
        align-items: end;
        margin-bottom: 46px;
      }

      .section-index {
        display: block;
        margin-bottom: 18px;
        color: var(--blue);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
        letter-spacing: 0.13em;
      }

      .section-heading h2,
      .about-copy h2,
      .contact-inner h2 {
        margin-bottom: 0;
        font-size: clamp(34px, 4vw, 52px);
        line-height: 1.07;
        letter-spacing: -0.045em;
      }

      .section-heading > p {
        max-width: 430px;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.7;
      }

      .expertise-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--border);
        border-left: 1px solid var(--border);
      }

      .expertise-card {
        min-height: 290px;
        padding: 28px;
        border-right: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.012);
        transition:
          background 180ms ease,
          transform 180ms ease;
      }

      .expertise-card:hover {
        z-index: 2;
        background: var(--surface-hover);
        transform: translateY(-2px);
      }

      .card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 52px;
      }

      .card-icon {
        display: grid;
        width: 32px;
        height: 32px;
        place-items: center;
        border: 1px solid var(--border-strong);
        border-radius: 8px;
      }

      .card-icon span {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--blue);
      }

      .card-arrow {
        color: #566270;
      }

      .expertise-card h3 {
        margin-bottom: 13px;
        font-size: 18px;
        letter-spacing: -0.02em;
      }

      .expertise-card p {
        min-height: 72px;
        margin-bottom: 25px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.65;
      }

      .tags {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .tags span {
        padding: 5px 8px;
      }

      .projects-section {
        border-block: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.012);
      }

      .project-list {
        border-top: 1px solid var(--border);
      }

      .project {
        display: grid;
        grid-template-columns: 70px 1fr auto;
        gap: 25px;
        align-items: start;
        padding: 34px 12px;
        border-bottom: 1px solid var(--border);
        transition:
          padding 180ms ease,
          background 180ms ease;
      }

      .project:hover {
        padding-inline: 24px;
        background: rgba(255, 255, 255, 0.018);
      }

      .project-number {
        padding-top: 5px;
        color: var(--blue);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
      }

      .project-content h3 {
        margin-bottom: 10px;
        font-size: 22px;
        letter-spacing: -0.025em;
      }

      .project-content p {
        max-width: 750px;
        margin-bottom: 16px;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.7;
      }

      .project-stack {
        color: var(--muted-strong);
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 10px;
      }

      .project-case-link {
        margin-left: 18px;
        display: inline-flex;
        gap: 7px;
        align-items: center;
        margin-top: 22px;
        color: var(--blue);
        font-size: 12px;
        font-weight: 700;
      }

      .project-case-link:hover {
        color: #82a8ff;
      }



      .about-card {
        display: grid;
        grid-template-columns: 1.35fr 0.65fr;
        gap: 80px;
        padding: 58px;
        border: 1px solid var(--border-strong);
        border-radius: 24px;
        background:
          radial-gradient(
            circle at 90% 10%,
            rgba(91, 140, 255, 0.12),
            transparent 30%
          ),
