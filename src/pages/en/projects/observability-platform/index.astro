---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";

const responsibilities = [
  "Monitoring and observability architecture",
  "Infrastructure metrics collection",
  "Server and virtualization monitoring",
  "Network infrastructure monitoring",
  "Centralized log collection",
  "Security telemetry and Wazuh events",
  "Actionable alerting",
  "Dashboards, diagnostics and runbooks",
];

const outcomes = [
  {
    value: "40+",
    label: "servers and infrastructure systems",
  },
  {
    value: "Multiple",
    label: "production sites",
  },
  {
    value: "Unified",
    label: "operational view",
  },
];
---

<BaseLayout
  title="Observability Platform — Tudor Shandrov"
  description="Tudor Shandrov case study on building an observability platform with Prometheus, Grafana, Loki, Zabbix and Wazuh: metrics, logs, events, alerting and operational diagnostics."
  lang="en"
>
  <div class="page-glow"></div>
  <SiteHeader lang="en" />

  <main>
    <section class="hero container">
      <a class="back" href="/en/#projects">
        ← Projects
      </a>

      <div class="hero-grid">
        <div>
          <span class="index">
            CASE STUDY / 03
          </span>

          <h1>
            Observability
            <span>Platform.</span>
          </h1>

          <p class="lead">
            A unified operational view of servers, virtualization,
            network infrastructure and services: metrics, checks,
            logs, security events and actionable alerts.
          </p>
        </div>

        <aside class="summary">
          <div>
            <span>Role</span>
            <strong>
              Lead Infrastructure Engineer
            </strong>
          </div>

          <div>
            <span>Scope</span>
            <strong>
              Multiple production sites
            </strong>
          </div>

          <div>
            <span>Operating model</span>
            <strong>
              Observe → alert → diagnose → act
            </strong>
          </div>

          <div>
            <span>Disclosure</span>
            <strong>
              Architecture anonymized
            </strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="metrics">
      <div class="container metrics-grid">
        {
          outcomes.map((item) => (
            <div class="metric">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        01 / CONTEXT
      </div>

      <div class="two-column">
        <h2>
          Not just detecting failure,
          but understanding system state.
        </h2>

        <div class="copy">
          <p>
            As the infrastructure grew, simple availability checks were
            no longer enough. Troubleshooting required visibility not only
            into whether a service had failed, but also into the state of
            hosts, virtualization, networking, storage and infrastructure
            services before and during an incident.
          </p>

          <p>
            The observability platform brings heterogeneous signals into one
            operational view: metrics show trends, infrastructure checks
            capture state, logs provide context, and security telemetry adds
            another source of evidence during investigation.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          02 / RESPONSIBILITY
        </div>

        <div class="two-column">
          <h2>
            Responsibility from signal
            source to engineer response.
          </h2>

          <div class="responsibility-grid">
            {
              responsibilities.map((item, index) => (
                <div class="responsibility">
                  <span>
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <strong>{item}</strong>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        03 / ARCHITECTURE
      </div>

      <div class="two-column architecture-heading">
        <h2>
          Different signals,
          one operational model.
        </h2>

        <p>
          The diagram is intentionally abstracted. It shows functional
          observability layers without exposing customer addressing,
          system names, internal endpoints or security details.
        </p>
      </div>

      <div class="architecture">
        <div class="architecture-row">
          <div class="arch-node accent">
            <span>SOURCES</span>
            <strong>Infrastructure and services</strong>
            <small>
              Linux · virtualization · network · storage
            </small>
          </div>
        </div>

        <div class="branch-connector">
          <span class="branch-stem"></span>
          <span class="branch-bus"></span>
          <span class="branch-drop branch-drop-left"></span>
          <span class="branch-drop branch-drop-center"></span>
          <span class="branch-drop branch-drop-right"></span>
        </div>

        <div class="architecture-row architecture-three">
          <div class="arch-node">
            <span>METRICS</span>
            <strong>Prometheus</strong>
            <small>
              Exporters · API integrations
            </small>
          </div>

          <div class="arch-node">
            <span>CHECKS</span>
            <strong>Zabbix</strong>
            <small>
              Hosts · services · network
            </small>
          </div>

          <div class="arch-node">
            <span>LOGS</span>
            <strong>Loki · rsyslog</strong>
            <small>
              Centralized log collection
            </small>
          </div>
        </div>

        <div class="connector"></div>

        <div class="architecture-row architecture-three">
          <div class="arch-node">
            <span>SECURITY EVENTS</span>
            <strong>Wazuh</strong>
            <small>
              Agents · events · SCA
            </small>
          </div>

          <div class="arch-node">
            <span>VISUALIZATION</span>
            <strong>Grafana</strong>
            <small>
              Dashboards · investigation
            </small>
          </div>

          <div class="arch-node">
            <span>OPERATIONS</span>
            <strong>Alerting and response</strong>
            <small>
              Alerts · diagnosis · runbooks
            </small>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          04 / METRICS
        </div>

        <div class="delivery">
          <article>
            <span>01</span>
            <h3>Servers</h3>
            <p>
              CPU, memory, filesystems, networking and system components
              provide visibility into current load and abnormal behavior.
            </p>
          </article>

          <article>
            <span>02</span>
            <h3>Virtualization</h3>
            <p>
              Cluster, node and workload state complements host metrics
              and helps connect virtual-machine issues with the condition
              of the underlying platform.
            </p>
          </article>

          <article>
            <span>03</span>
            <h3>Networking</h3>
            <p>
              Availability, interface state, network devices and connectivity
              checks help distinguish application failures from transport
              infrastructure problems.
            </p>
          </article>

          <article>
            <span>04</span>
            <h3>Storage</h3>
            <p>
              Storage health, capacity and related indicators are monitored
              together with the compute platform rather than as an isolated
              infrastructure component.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        05 / LOGS & EVENTS
      </div>

      <div class="two-column">
        <h2>
          A metric shows deviation.
          A log helps explain why.
        </h2>

        <div class="copy">
          <p>
            Centralized log collection through Loki and rsyslog provides
            context for infrastructure events and makes it possible to search
            related messages without connecting to each server individually.
          </p>

          <p>
            Security events are handled through a separate Wazuh plane.
            This keeps operational monitoring distinct from security
            telemetry while allowing both signal sources to support
            incident investigation.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          06 / OPERATIONS
        </div>

        <div class="two-column">
          <h2>
            A useful alert matters more
            than a large number of alerts.
          </h2>

          <div class="copy">
            <p>
              Rules and thresholds are tuned so that an alert represents
              a condition requiring action rather than every short-lived
              deviation. This reduces alert fatigue and increases trust
              in the monitoring system.
            </p>

            <p>
              Investigations combine multiple signal sources: current and
              historical metrics, infrastructure checks, logs and security
              events. Repeatable actions are documented and turned into
              operational procedures and runbooks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="result">
      <div class="container result-grid">
        <span class="section-number">
          07 / RESULT
        </span>

        <h2>
          Observability as an
          operations tool,
          not a collection
          of dashboards.
        </h2>

        <p>
          Metrics, infrastructure checks, centralized logs, security events,
          visualization and alerting operate as one working model. Engineers
          receive not only a signal that something is wrong, but also the
          context needed to diagnose the issue and decide what to do next.
        </p>

        <a href="/en/#projects">
          ← Back to projects
        </a>
      </div>
    </section>
  </main>

  <SiteFooter lang="en" />

<style is:global>
      :root {
        color-scheme: dark;

        --bg: #0b0f14;
        --surface: #121920;
        --surface-2: #151e27;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.15);

        --text: #f2f5f7;
        --muted: #9aa7b4;
        --muted-strong: #c1cad3;

        --blue: #5b8cff;
        --cyan: #52d3c5;

        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;

        color: var(--text);

        background:
          linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          var(--bg);

        background-size: 48px 48px;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(
          calc(100% - 48px),
          var(--container)
        );

        margin-inline: auto;
      }

      .page-glow {
        position: fixed;
        z-index: -1;
        top: -250px;
        right: -200px;

        width: 600px;
        height: 600px;

        border-radius: 50%;

        background: var(--blue);

        opacity: 0.08;
        filter: blur(150px);
      }

      .hero {
        padding-block: 92px 110px;
      }

      .back {
        display: inline-block;

        margin-bottom: 72px;

        color: var(--muted);

        font-size: 12px;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns:
          minmax(0, 1.2fr)
          minmax(320px, 0.8fr);

        gap: 90px;
      }

      .index,
      .section-number {
        display: block;

        margin-bottom: 22px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 10px;
        letter-spacing: 0.13em;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 690px;

        margin-bottom: 30px;

        font-size:
          clamp(52px, 7vw, 82px);

        line-height: 0.96;
        letter-spacing: -0.055em;
      }

      h1 span {
        display: block;

        color: var(--muted);

        font-weight: 500;
      }

      .lead {
        max-width: 720px;

        margin-bottom: 0;

        color: var(--muted-strong);

        font-size: 18px;
        line-height: 1.7;
      }

      .summary {
        align-self: end;

        border-top:
          1px solid var(--border-strong);
      }

      .summary > div {
        display: flex;
        flex-direction: column;
        gap: 6px;

        padding: 17px 0;

        border-bottom:
          1px solid var(--border);
      }

      .summary span {
        color: var(--muted);
        font-size: 10px;
      }

      .summary strong {
        font-size: 12px;
      }

      .metrics {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .metrics-grid {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);
      }

      .metric {
        display: flex;
        min-height: 140px;

        flex-direction: column;
        justify-content: center;

        padding: 30px;

        border-right:
          1px solid var(--border);
      }

      .metric:first-child {
        border-left:
          1px solid var(--border);
      }

      .metric strong {
        margin-bottom: 5px;

        font-size: 25px;
        letter-spacing: -0.035em;
      }

      .metric span {
        color: var(--muted);
        font-size: 11px;
      }

      .section {
        padding-block: 110px;
      }

      .section-dark {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .two-column h2,
      .result h2 {
        max-width: 650px;

        margin-bottom: 0;

        font-size:
          clamp(36px, 4.5vw, 54px);

        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .copy p,
      .architecture-heading p,
      .result p {
        color: var(--muted);

        font-size: 14px;
        line-height: 1.8;
      }

      .copy p:last-child {
        margin-bottom: 0;
      }

      .responsibility-grid {
        display: grid;
        grid-template-columns:
          1fr 1fr;

        border-top:
          1px solid var(--border);
      }

      .responsibility {
        display: flex;
        min-height: 92px;

        gap: 15px;
        align-items: center;

        padding: 18px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .responsibility span {
        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .responsibility strong {
        font-size: 12px;
      }

      .architecture-heading {
        align-items: end;

        margin-bottom: 52px;
      }

      .architecture-heading p {
        max-width: 420px;
        margin-bottom: 0;
      }

      .architecture {
        padding: 42px;

        border: 1px solid var(--border-strong);
        border-radius: 20px;

        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.03),
            transparent
          ),
          var(--surface);
      }

      .architecture-row {
        display: flex;
        justify-content: center;
      }

      .architecture-three {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);

        gap: 16px;
      }

      .arch-node {
        display: flex;

        min-height: 135px;

        flex-direction: column;
        justify-content: center;

        padding: 22px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        background:
          rgba(11,15,20,.65);
      }

      .arch-node.accent {
        width: min(100%, 500px);

        border-color:
          rgba(91,140,255,.35);

        background:
          rgba(91,140,255,.07);
      }

      .arch-node span {
        margin-bottom: 11px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
        letter-spacing: .11em;
      }

      .arch-node strong {
        margin-bottom: 7px;

        font-size: 15px;
      }

      .arch-node small {
        color: var(--muted);

        font-size: 11px;
      }

      .connector {
        width: 1px;
        height: 34px;

        margin-inline: auto;

        background:
          linear-gradient(
            var(--blue),
            rgba(91,140,255,.15)
          );
      }



      .delivery {
        display: grid;
        grid-template-columns:
          repeat(4, 1fr);

        border-top:
          1px solid var(--border);
        border-left:
          1px solid var(--border);
      }

      .delivery article {
        min-height: 270px;

        padding: 28px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .delivery article > span {
        display: block;

        margin-bottom: 65px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .delivery h3 {
        margin-bottom: 14px;

        font-size: 17px;
      }

      .delivery p {
        margin-bottom: 0;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.7;
      }

      .result {
        padding-block: 110px;

        border-top:
          1px solid var(--border);

        background:
          linear-gradient(
            135deg,
            rgba(91,140,255,.08),
            transparent 45%
          );
      }

      .result-grid {
        display: grid;
        grid-template-columns:
          0.35fr 1.4fr 0.75fr;

        gap: 55px;
        align-items: start;
      }

      .result p {
        margin-bottom: 0;
      }

      .result a {
        grid-column: 2;

        width: max-content;

        margin-top: 12px;

        color: var(--blue);

        font-size: 12px;
        font-weight: 700;
      }

      @media (max-width: 900px) {


        .hero-grid,
        .two-column,
        .result-grid {
          grid-template-columns: 1fr;
          gap: 45px;
        }

        .metrics-grid,
        .architecture-three {
          grid-template-columns: 1fr;
        }

        .metric {
          border-bottom:
            1px solid var(--border);
          border-left:
            1px solid var(--border);
        }

        .responsibility-grid {
          grid-template-columns: 1fr;
        }

        .delivery {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .result a {
          grid-column: 1;
        }
      }

      @media (max-width: 640px) {
        .container {
          width:
            min(calc(100% - 30px), var(--container));
        }

        .hero {
          padding-block: 65px 80px;
        }

        .back {
          margin-bottom: 50px;
        }

        h1 {
          font-size:
            clamp(34px, 10.8vw, 48px);
          line-height: 1.02;
          overflow-wrap: anywhere;
        }

        .section {
          padding-block: 80px;
        }

        .architecture {
          padding: 16px;
        }

        .summary strong,
        .arch-node strong,
        .arch-node small {
          overflow-wrap: anywhere;
        }

        .delivery {
          grid-template-columns: 1fr;
        }


      }


      .branch-connector {
          position: relative;
          z-index: 3;
          width: 66.666%;
          height: 54px;
          margin-inline: auto;
        }

        .branch-stem {
          position: absolute;
          top: 0;
          left: 50%;
          width: 1px;
          height: 27px;
          background: rgba(91, 140, 255, 0.7);
        }

        .branch-bus {
          position: absolute;
          top: 26px;
          left: 0;
          right: 0;
          height: 1px;
          background: rgba(91, 140, 255, 0.55);
        }

        .branch-drop {
          position: absolute;
          top: 26px;
          width: 1px;
          height: 28px;
          background: rgba(91, 140, 255, 0.55);
        }

        .branch-drop-left {
          left: 0;
        }

        .branch-drop-center {
          left: 50%;
        }

        .branch-drop-right {
          right: 0;
        }

        @media (max-width: 900px) {
          .branch-connector {
            display: none;
          }
        }
    </style>
</BaseLayout>
