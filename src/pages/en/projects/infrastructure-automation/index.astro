---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../../components/SiteHeader.astro";
import SiteFooter from "../../../../components/SiteFooter.astro";

const projects = [
  {
    "number": "01",
    "tag": "Endpoint management",
    "name": "Veyon GPO Deployment",
    "summary": "Centralized Veyon Service rollout to Windows 10/11 clients: package and configuration verification, service state, firewall rules, and authentication troubleshooting.",
    "detail": "GPO → Scheduled Task (SYSTEM) → PowerShell",
    "notes": "Checksums and signing, idempotence, access control, troubleshooting.",
    "repo": "https://github.com/greksw/veyon-gpo-deployment",
    "article": "https://notes.shandrov.ru/notes/windows/veyon-workgroup-ad-authentication-gpo-diagnostics/"
  },
  {
    "number": "02",
    "tag": "Software deployment and updates",
    "name": "7-Zip GPO Deployment",
    "summary": "Manifest-driven 7-Zip MSI installation and updates using SHA256, msiexec and Scheduled Tasks. A shared mutex prevents conflicting jobs; RDS updates are deferred while user sessions exist.",
    "detail": "GPO → Scheduled Task (SYSTEM) → MSI",
    "notes": "Version checks, audit logs, SYSVOL/DFSR validation, RDS deferral.",
    "repo": "https://github.com/greksw/7zip-gpo-deployment",
    "article": "https://notes.shandrov.ru/notes/windows/gpo-software-deployment-7zip-auto-update/"
  },
  {
    "number": "03",
    "tag": "User application governance",
    "name": "Windows AppCleanup GPO",
    "summary": "Inventory and targeted removal of current-user Windows Appx packages using exact package identities, with separate Audit and Enforce modes.",
    "detail": "User GPO → Logon Script → PowerShell",
    "notes": "Protected SystemApps, OneDrive and Outlook safeguards, audit-first rollout.",
    "repo": "https://github.com/greksw/windows-appcleanup-gpo",
    "article": "https://notes.shandrov.ru/notes/windows/gpo-windows-appx-cleanup-user-logon/"
  }
];
---

<BaseLayout
  title="Infrastructure Automation — Windows GPO and PowerShell | Tudor Shandrov"
  description="Three practical Windows infrastructure automation projects using Active Directory GPO and PowerShell: Veyon, 7-Zip MSI deployment, and controlled Appx cleanup."
  lang="en"
>
  <div class="page-glow"></div>
  <SiteHeader lang="en" />

  <main>
    <section class="hero container">
      <a class="back" href="/en/#projects">← All projects</a>
      <div class="intro">
        <span class="eyebrow">CASE STUDY / 06</span>
        <h1>Infrastructure<br /><span>Automation.</span></h1>
        <p class="lead">Three practical projects for operating Windows infrastructure: centrally managed GPO changes, traceable PowerShell workflows, diagnostics, and explicit safety boundaries.</p>
      </div>
      <div class="summary" aria-label="Implementation and outcomes">
        <div><span class="summary-number">01</span><strong>3 public code repositories</strong></div>
        <div><span class="summary-number">02</span><strong>GPO + PowerShell 5.1</strong></div>
        <div><span class="summary-number">03</span><strong>Bilingual technical case studies</strong></div>
      </div>
    </section>

    <section class="projects-section">
      <div class="container">
        <div class="section-header">
          <span class="eyebrow">GPO / POWERSHELL / OPERATIONS</span>
          <h2>Implementation and outcomes</h2>
          <p>Moving from an isolated script to an operationally controlled workflow: targeting, safe execution, repeatability, and observability.</p>
        </div>

        <div class="automation-list">
          {projects.map((project) => (
            <article class="automation-card">
              <div class="automation-card-top">
                <span class="project-index">{project.number} / 03</span>
                <span class="project-tag">{project.tag}</span>
              </div>
              <h3>{project.name}</h3>
              <p class="card-description">{project.summary}</p>
              <div class="workflow">{project.detail}</div>
              <p class="card-note">{project.notes}</p>
              <div class="card-links">
                <a href={project.repo} target="_blank" rel="noopener noreferrer">View GitHub sources ↗</a>
                <a href={project.article} target="_blank" rel="noopener noreferrer">Read the technical case ↗</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container approach">
      <span class="eyebrow">Source code and implementation notes</span>
      <h2>Engineering approach</h2>
      <p>Each project separates GPO targeting and delivery from the PowerShell application logic, defines its execution context, checks system state, and logs results. Machine-wide deployment tasks run as SYSTEM; user-scoped Appx operations run as the interactive user.</p>
      <div class="disclosure">Public repositories contain anonymized adaptations and reconstructed source history. CI checks static syntax, not production suitability. Actual AD domains, OU names, account identities, and internal addresses are not disclosed.</div>
    </section>
  </main>

  <SiteFooter lang="en" />

  <style>
    .page-glow { position: absolute; inset: 80px 0 auto; height: 420px; pointer-events: none; background: radial-gradient(ellipse at 52% 0%, rgba(91,140,255,.10), transparent 65%); }
    .container { width: min(calc(100% - 48px), var(--container)); margin-inline: auto; }
    .hero { position: relative; padding-block: 80px 72px; }
    .back { display: inline-block; margin-bottom: 48px; color: var(--muted-strong); font-size: 12px; transition: color .15s; }
    .back:hover, .card-links a:hover { color: #9bb7ff; }
    .eyebrow { font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--blue); letter-spacing: .12em; text-transform: uppercase; }
    .intro { max-width: 900px; }
    h1 { margin: 24px 0; font-size: clamp(52px, 7vw, 92px); line-height: 1.03; letter-spacing: -.058em; }
    h1 span { color: var(--blue); }
    .lead { max-width: 790px; color: var(--muted-strong); font-size: clamp(16px, 2vw, 19px); line-height: 1.8; }
    .summary { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin-top: 62px; border-block: 1px solid var(--border); }
    .summary > div { display: flex; gap: 15px; padding: 24px 20px; align-items: center; border-right: 1px solid var(--border); }
    .summary > div:first-child { padding-left: 0; }
    .summary > div:last-child { border: none; }
    .summary-number { color: var(--blue); font: 600 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .summary strong { font-size: 13px; font-weight: 600; }
    .projects-section { padding-block: 74px 96px; background: rgba(255,255,255,.014); border-block: 1px solid var(--border); }
    .section-header { max-width: 820px; margin-bottom: 42px; }
    h2 { margin: 16px 0; font-size: clamp(30px, 4vw, 43px); letter-spacing: -.04em; }
    .section-header p, .approach > p { color: var(--muted); font-size: 14px; line-height: 1.9; }
    .automation-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
    .automation-card { display: flex; flex-direction: column; min-width: 0; padding: 30px 26px; border: 1px solid var(--border-strong); border-radius: 16px; background: var(--surface); }
    .automation-card-top { display: flex; gap: 12px; justify-content: space-between; align-items: start; margin-bottom: 38px; }
    .project-index { color: var(--blue); font: 700 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .project-tag { color: var(--muted); font-size: 11px; text-align: right; }
    h3 { margin: 0 0 16px; font-size: 23px; line-height: 1.25; letter-spacing: -.025em; }
    .card-description { margin: 0 0 20px; color: var(--muted-strong); font-size: 13px; line-height: 1.8; }
    .workflow { padding: 13px 12px; border: 1px solid var(--border); border-radius: 8px; color: var(--cyan); background: rgba(82,211,197,.04); font: 500 11px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; overflow-wrap: anywhere; }
    .card-note { margin: 16px 0 30px; color: var(--muted); font-size: 12px; line-height: 1.8; }
    .card-links { display: flex; flex-direction: column; gap: 14px; margin-top: auto; padding-top: 21px; border-top: 1px solid var(--border); }
    .card-links a { width: fit-content; color: var(--blue); font-size: 12px; font-weight: 700; transition: color .15s; }
    .approach { padding-block: 82px 96px; }
    .approach > p { max-width: 800px; }
    .disclosure { max-width: 950px; margin-top: 28px; padding: 20px 24px; border-left: 2px solid var(--blue); background: rgba(91,140,255,.045); color: var(--muted-strong); font-size: 12px; line-height: 1.85; }
    @media (max-width: 980px) { .automation-list { grid-template-columns: 1fr; } .automation-card-top { margin-bottom: 22px; } .summary { grid-template-columns: 1fr; } .summary > div,.summary > div:first-child { padding: 18px 0; border-right: 0; border-bottom: 1px solid var(--border); } .summary > div:last-child { border-bottom: 0; } }
    @media (max-width: 600px) { .hero { padding-block: 46px 60px; } .projects-section { padding-block: 55px; } .approach { padding-block: 60px; } .automation-card { padding: 23px 20px; } .container { width: min(calc(100% - 32px), var(--container)); } }
  </style>
</BaseLayout>
