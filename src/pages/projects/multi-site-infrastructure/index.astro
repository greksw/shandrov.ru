---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const responsibilities = [
  "Архитектура сети нескольких площадок",
  "VLAN-сегментация и политики доступа",
  "Маршрутизация и межплощадочная связность",
  "IPsec, WireGuard и OpenVPN",
  "Multi-WAN и резервирование каналов",
  "Firewall, NAT и policy routing",
  "Контролируемый межсегментный доступ",
  "Диагностика, мониторинг и документация",
];

const outcomes = [
  {
    value: "50+ VLAN",
    label: "сегментированная инфраструктура",
  },
  {
    value: "Несколько",
    label: "production-площадок",
  },
  {
    value: "Multi-WAN",
    label: "резервирование внешней связности",
  },
];
---

<BaseLayout
  title="Многоплощадочная инфраструктура — Tudor Shandrov"
  description="Кейс Tudor Shandrov: многоплощадочная сеть, VLAN-сегментация, VPN, маршрутизация, Multi-WAN и контролируемый межсегментный доступ."
  lang="ru"
>
  <div class="page-glow"></div>
  <SiteHeader lang="ru" />

  <main>
    <section class="hero container">
      <a class="back" href="/#projects">
        ← Проекты
      </a>

      <div class="hero-grid">
        <div>
          <span class="index">
            КЕЙС / 01
          </span>

          <h1>
            Многоплощадочная
            <span>инфраструктура.</span>
          </h1>

          <p class="lead">
            Сегментация, защищённая связность, маршрутизация
            и единая эксплуатационная модель для распределённой
            production-инфраструктуры.
          </p>
        </div>

        <aside class="summary">
          <div>
            <span>Роль</span>
            <strong>
              Ведущий инженер инфраструктуры
            </strong>
          </div>

          <div>
            <span>Масштаб</span>
            <strong>
              Несколько production-площадок
            </strong>
          </div>

          <div>
            <span>Модель</span>
            <strong>
              Segment → connect → control → operate
            </strong>
          </div>

          <div>
            <span>Раскрытие данных</span>
            <strong>
              Архитектура обезличена
            </strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="metrics">
      <div class="container metrics-grid">
        {
          outcomes.map((item) => (
            <div class="metric">
              <strong>{item.value}</strong>
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        01 / КОНТЕКСТ
      </div>

      <div class="two-column">
        <h2>
          Единая инфраструктура
          не должна становиться
          плоской сетью.
        </h2>

        <div class="copy">
          <p>
            Несколько площадок должны совместно использовать
            инфраструктурные сервисы и обеспечивать необходимую
            связность между пользователями, серверами и системами,
            сохраняя при этом независимые зоны безопасности.
          </p>

          <p>
            Поэтому сеть проектируется не как единый trust domain,
            а как набор сегментированных площадок с явно определёнными
            маршрутами, VPN-связями и направлениями доступа.
            Связность разрешается там, где она действительно нужна
            сервисам и эксплуатационным процессам.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          02 / ОТВЕТСТВЕННОСТЬ
        </div>

        <div class="two-column">
          <h2>
            Ответственность от локального
            сегмента до межплощадочного маршрута.
          </h2>

          <div class="responsibility-grid">
            {
              responsibilities.map((item, index) => (
                <div class="responsibility">
                  <span>
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <strong>{item}</strong>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        03 / АРХИТЕКТУРА
      </div>

      <div class="two-column architecture-heading">
        <h2>
          Площадки связаны,
          но остаются разделёнными.
        </h2>

        <p>
          Схема намеренно абстрагирована. Она показывает функциональные
          уровни сети без раскрытия клиентской адресации, названий площадок,
          провайдеров, туннельных endpoint и внутренних правил безопасности.
        </p>
      </div>

      <div class="architecture">
        <div class="architecture-row">
          <div class="arch-node accent">
            <span>ПЛОЩАДКИ И СЕГМЕНТЫ</span>
            <strong>Изолированные локальные зоны</strong>
            <small>
              Users · servers · voice · management
            </small>
          </div>
        </div>

        <div class="branch-connector">
          <span class="branch-stem"></span>
          <span class="branch-bus"></span>
          <span class="branch-drop branch-drop-left"></span>
          <span class="branch-drop branch-drop-center"></span>
          <span class="branch-drop branch-drop-right"></span>
        </div>

        <div class="architecture-row architecture-three">
          <div class="arch-node">
            <span>МАРШРУТИЗАЦИЯ</span>
            <strong>Управляемый routing</strong>
            <small>
              VLAN · routes · policy routing
            </small>
          </div>

          <div class="arch-node">
            <span>VPN</span>
            <strong>Защищённая связность</strong>
            <small>
              IPsec · WireGuard · OpenVPN
            </small>
          </div>

          <div class="arch-node">
            <span>WAN</span>
            <strong>Резервирование каналов</strong>
            <small>
              Primary · backup · failover
            </small>
          </div>
        </div>

        <div class="connector"></div>

        <div class="architecture-row architecture-three">
          <div class="arch-node">
            <span>ДОСТУП</span>
            <strong>Контролируемые направления</strong>
            <small>
              Firewall · least privilege · no-NAT
            </small>
          </div>

          <div class="arch-node">
            <span>СЕРВИСЫ</span>
            <strong>Общие инфраструктурные сервисы</strong>
            <small>
              DNS · identity · monitoring
            </small>
          </div>

          <div class="arch-node">
            <span>ЭКСПЛУАТАЦИЯ</span>
            <strong>Единая operational-модель</strong>
            <small>
              Monitoring · diagnostics · runbooks
            </small>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          04 / СЕГМЕНТАЦИЯ
        </div>

        <div class="delivery">
          <article>
            <span>01</span>
            <h3>Пользователи</h3>
            <p>
              Рабочие станции и пользовательские устройства отделены
              от серверных и административных сегментов и получают
              только необходимый доступ к сервисам.
            </p>
          </article>

          <article>
            <span>02</span>
            <h3>Серверы</h3>
            <p>
              Серверные сети выделены в отдельные зоны с контролируемыми
              маршрутами к пользователям, сервисам и другим площадкам.
            </p>
          </article>

          <article>
            <span>03</span>
            <h3>Voice и специализированные сети</h3>
            <p>
              Телефония, видеонаблюдение, печать и другие специализированные
              системы не смешиваются с обычным пользовательским трафиком.
            </p>
          </article>

          <article>
            <span>04</span>
            <h3>Management</h3>
            <p>
              Управление сетевым и серверным оборудованием отделено
              от пользовательских сегментов и доступно только
              из административных зон.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">
        05 / СВЯЗНОСТЬ И ОТКАЗОУСТОЙЧИВОСТЬ
      </div>

      <div class="two-column">
        <h2>
          Маршрут должен быть
          предсказуем даже при отказе канала.
        </h2>

        <div class="copy">
          <p>
            Межплощадочная связность строится на защищённых VPN-туннелях
            и явных маршрутах. Для разных сценариев используются IPsec,
            WireGuard и OpenVPN — в зависимости от требований к площадке,
            клиенту или сервису.
          </p>

          <p>
            На площадках с несколькими интернет-каналами применяются
            failover и policy routing. Отдельные направления и сервисы
            могут использовать заданный uplink, при этом отказ основного
            канала не должен превращаться в ручное переключение всей сети.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">
          06 / ЭКСПЛУАТАЦИЯ
        </div>

        <div class="two-column">
          <h2>
            Сложная сеть должна
            оставаться диагностируемой.
          </h2>

          <div class="copy">
            <p>
              При изменениях проверяются маршруты, состояния туннелей,
              таблицы routing, NAT и firewall-политики. Диагностика строится
              от конкретного потока трафика, а не от предположения,
              что проблема находится на одной стороне VPN.
            </p>

            <p>
              Повторяемые правила между площадками документируются,
              сетевые устройства и туннели контролируются мониторингом,
              а изменения выполняются так, чтобы сохранять понятную
              эксплуатационную модель по мере роста инфраструктуры.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="result">
      <div class="container result-grid">
        <span class="section-number">
          07 / РЕЗУЛЬТАТ
        </span>

        <h2>
          Несколько площадок —
          одна управляемая
          инфраструктура.
        </h2>

        <p>
          Сегментация, маршрутизация, VPN, резервирование внешних каналов
          и политики доступа работают как единая модель. Площадки могут
          совместно использовать необходимые сервисы, не превращаясь
          при этом в один плоский и полностью доверенный сетевой домен.
        </p>

        <a href="/#projects">
          ← Назад к проектам
        </a>
      </div>
    </section>
  </main>

  <SiteFooter lang="ru" />

<style is:global>
      :root {
        color-scheme: dark;

        --bg: #0b0f14;
        --surface: #121920;
        --surface-2: #151e27;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.15);

        --text: #f2f5f7;
        --muted: #9aa7b4;
        --muted-strong: #c1cad3;

        --blue: #5b8cff;
        --cyan: #52d3c5;

        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;

        color: var(--text);

        background:
          linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          var(--bg);

        background-size: 48px 48px;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(
          calc(100% - 48px),
          var(--container)
        );

        margin-inline: auto;
      }

      .page-glow {
        position: fixed;
        z-index: -1;
        top: -250px;
        right: -200px;

        width: 600px;
        height: 600px;

        border-radius: 50%;

        background: var(--blue);

        opacity: 0.08;
        filter: blur(150px);
      }

      .hero {
        padding-block: 92px 110px;
      }

      .back {
        display: inline-block;

        margin-bottom: 72px;

        color: var(--muted);

        font-size: 12px;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns:
          minmax(0, 1.2fr)
          minmax(320px, 0.8fr);

        gap: 90px;
      }

      .index,
      .section-number {
        display: block;

        margin-bottom: 22px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 10px;
        letter-spacing: 0.13em;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 690px;

        margin-bottom: 30px;

        font-size:
          clamp(52px, 7vw, 82px);

        line-height: 0.96;
        letter-spacing: -0.055em;
      }

      h1 span {
        display: block;

        color: var(--muted);

        font-weight: 500;
      }

      .lead {
        max-width: 720px;

        margin-bottom: 0;

        color: var(--muted-strong);

        font-size: 18px;
        line-height: 1.7;
      }

      .summary {
        align-self: end;

        border-top:
          1px solid var(--border-strong);
      }

      .summary > div {
        display: flex;
        flex-direction: column;
        gap: 6px;

        padding: 17px 0;

        border-bottom:
          1px solid var(--border);
      }

      .summary span {
        color: var(--muted);
        font-size: 10px;
      }

      .summary strong {
        font-size: 12px;
      }

      .metrics {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .metrics-grid {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);
      }

      .metric {
        display: flex;
        min-height: 140px;

        flex-direction: column;
        justify-content: center;

        padding: 30px;

        border-right:
          1px solid var(--border);
      }

      .metric:first-child {
        border-left:
          1px solid var(--border);
      }

      .metric strong {
        margin-bottom: 5px;

        font-size: 25px;
        letter-spacing: -0.035em;
      }

      .metric span {
        color: var(--muted);
        font-size: 11px;
      }

      .section {
        padding-block: 110px;
      }

      .section-dark {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .two-column h2,
      .result h2 {
        max-width: 650px;

        margin-bottom: 0;

        font-size:
          clamp(36px, 4.5vw, 54px);

        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .copy p,
      .architecture-heading p,
      .result p {
        color: var(--muted);

        font-size: 14px;
        line-height: 1.8;
      }

      .copy p:last-child {
        margin-bottom: 0;
      }

      .responsibility-grid {
        display: grid;
        grid-template-columns:
          1fr 1fr;

        border-top:
          1px solid var(--border);
      }

      .responsibility {
        display: flex;
        min-height: 92px;

        gap: 15px;
        align-items: center;

        padding: 18px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .responsibility span {
        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .responsibility strong {
        font-size: 12px;
      }

      .architecture-heading {
        align-items: end;

        margin-bottom: 52px;
      }

      .architecture-heading p {
        max-width: 420px;
        margin-bottom: 0;
      }

      .architecture {
        padding: 42px;

        border: 1px solid var(--border-strong);
        border-radius: 20px;

        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.03),
            transparent
          ),
          var(--surface);
      }

      .architecture-row {
        display: flex;
        justify-content: center;
      }

      .architecture-three {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);

        gap: 16px;
      }

      .arch-node {
        display: flex;

        min-height: 135px;

        flex-direction: column;
        justify-content: center;

        padding: 22px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        background:
          rgba(11,15,20,.65);
      }

      .arch-node.accent {
        width: min(100%, 500px);

        border-color:
          rgba(91,140,255,.35);

        background:
          rgba(91,140,255,.07);
      }

      .arch-node span {
        margin-bottom: 11px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
        letter-spacing: .11em;
      }

      .arch-node strong {
        margin-bottom: 7px;

        font-size: 15px;
      }

      .arch-node small {
        color: var(--muted);

        font-size: 11px;
      }

      .connector {
        width: 1px;
        height: 34px;

        margin-inline: auto;

        background:
          linear-gradient(
            var(--blue),
            rgba(91,140,255,.15)
          );
      }



      .delivery {
        display: grid;
        grid-template-columns:
          repeat(4, 1fr);

        border-top:
          1px solid var(--border);
        border-left:
          1px solid var(--border);
      }

      .delivery article {
        min-height: 270px;

        padding: 28px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .delivery article > span {
        display: block;

        margin-bottom: 65px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .delivery h3 {
        margin-bottom: 14px;

        font-size: 17px;
      }

      .delivery p {
        margin-bottom: 0;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.7;
      }

      .result {
        padding-block: 110px;

        border-top:
          1px solid var(--border);

        background:
          linear-gradient(
            135deg,
            rgba(91,140,255,.08),
            transparent 45%
          );
      }

      .result-grid {
        display: grid;
        grid-template-columns:
          0.35fr 1.4fr 0.75fr;

        gap: 55px;
        align-items: start;
      }

      .result p {
        margin-bottom: 0;
      }

      .result a {
        grid-column: 2;

        width: max-content;

        margin-top: 12px;

        color: var(--blue);

        font-size: 12px;
        font-weight: 700;
      }

      @media (max-width: 900px) {


        .hero-grid,
        .two-column,
        .result-grid {
          grid-template-columns: 1fr;
          gap: 45px;
        }

        .metrics-grid,
        .architecture-three {
          grid-template-columns: 1fr;
        }

        .metric {
          border-bottom:
            1px solid var(--border);
          border-left:
            1px solid var(--border);
        }

        .responsibility-grid {
          grid-template-columns: 1fr;
        }

        .delivery {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .result a {
          grid-column: 1;
        }
      }

      @media (max-width: 640px) {
        .container {
          width:
            min(calc(100% - 30px), var(--container));
        }

        .hero {
          padding-block: 65px 80px;
        }

        .back {
          margin-bottom: 50px;
        }

        h1 {
          font-size:
            clamp(34px, 10.8vw, 48px);
          line-height: 1.02;
          overflow-wrap: anywhere;
        }

        .section {
          padding-block: 80px;
        }

        .architecture {
          padding: 16px;
        }

        .summary strong,
        .arch-node strong,
        .arch-node small {
          overflow-wrap: anywhere;
        }

        .delivery {
          grid-template-columns: 1fr;
        }


      }


      .branch-connector {
          position: relative;
          z-index: 3;
          width: 66.666%;
          height: 54px;
          margin-inline: auto;
        }

        .branch-stem {
          position: absolute;
          top: 0;
          left: 50%;
          width: 1px;
          height: 27px;
          background: rgba(91, 140, 255, 0.7);
        }

        .branch-bus {
          position: absolute;
          top: 26px;
          left: 0;
          right: 0;
          height: 1px;
          background: rgba(91, 140, 255, 0.55);
        }

