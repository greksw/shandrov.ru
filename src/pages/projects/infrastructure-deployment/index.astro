---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const responsibilities = [
  "Требования и технический объём",
  "Подбор оборудования и сметы",
  "Проектирование сети и кабельной инфраструктуры",
  "Координация подрядчиков",
  "Развёртывание платформы виртуализации",
  "Службы идентификации и инфраструктурные сервисы",
  "Интеграция систем и миграция",
  "Техническая документация",
];

const outcomes = [
  {
    value: "3 узла",
    label: "кластер виртуализации",
  },
  {
    value: "2",
    label: "сервера идентификации",
  },
  {
    value: "Выделенная",
    label: "платформа резервного копирования",
  },
];
---

<BaseLayout
  title="Развёртывание инфраструктуры — Tudor Shandrov"
  description="Кейс Tudor Shandrov по развёртыванию IT-инфраструктуры: планирование, сеть, виртуализация, службы идентификации, миграция и передача в эксплуатацию."
  lang="ru"
>
<div class="page-glow"></div>
  <SiteHeader lang="ru" />

<main>
      <section class="hero container">
        <a class="back" href="/#projects">
          ← Проекты
        </a>

        <div class="hero-grid">
          <div>
            <span class="index">
              КЕЙС / 04
            </span>

            <h1>
            Развёртывание
            <span>инфраструктуры.</span>
          </h1>

            <p class="lead">
              Полный цикл создания новой production IT-среды — от меняющегося
            объёма проекта и физической инфраструктуры до виртуализации,
            служб идентификации, миграции и передачи в эксплуатацию.
            </p>
          </div>

          <aside class="summary">
            <div>
              <span>Роль</span>
              <strong>
                Ведущий инженер инфраструктуры
              </strong>
            </div>

            <div>
              <span>Масштаб</span>
              <strong>
                Новая production-площадка
              </strong>
            </div>

            <div>
              <span>Модель реализации</span>
              <strong>
                Архитектура → внедрение → эксплуатация
              </strong>
            </div>

            <div>
              <span>Раскрытие данных</span>
              <strong>
                Архитектура обезличена
              </strong>
            </div>
          </aside>
        </div>
      </section>

      <section class="metrics">
        <div class="container metrics-grid">
          {
            outcomes.map((item) => (
              <div class="metric">
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section container">
        <div class="section-number">
          01 / КОНТЕКСТ
        </div>

        <div class="two-column">
          <h2>
            Небольшая исходная задача
          выросла в полноценный
          инфраструктурный проект.
          </h2>

          <div class="copy">
            <p>
              Проект начинался с ограниченного объёма работ: структурированная
              кабельная система, развёртывание сети и видеонаблюдение.
              По мере развития площадки требования выросли до создания
              полноценной production IT-среды.
            </p>

            <p>
              Это изменило инженерную задачу: отдельные системы уже нельзя было
              проектировать независимо друг от друга. Сеть, вычислительные
              ресурсы, хранение данных, идентификацию, резервное копирование
              и миграцию пришлось проектировать как единую
              production-платформу.
            </p>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-number">
            02 / ОТВЕТСТВЕННОСТЬ
          </div>

          <div class="two-column">
            <h2>
              Ответственность за инженерную
          часть и реализацию проекта.
            </h2>

            <div class="responsibility-grid">
              {
                responsibilities.map((item, index) => (
                  <div class="responsibility">
                    <span>
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <strong>{item}</strong>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section container">
        <div class="section-number">
          03 / АРХИТЕКТУРА
        </div>

        <div class="two-column architecture-heading">
          <h2>
            Инфраструктура спроектирована как система связанных уровней.
          </h2>

          <p>
            Схема намеренно абстрагирована. Она показывает функциональные
              связи без раскрытия клиентской адресации, имён хостов
              и внутренних деталей безопасности.
          </p>
        </div>

        <div class="architecture">
          <div class="architecture-row">
            <div class="arch-node accent">
              <span>СЕТЬ</span>
              <strong>Сегментация и связность</strong>
              <small>
                VLAN · маршрутизация · коммутаторы доступа
              </small>
            </div>
          </div>

          <div class="branch-connector">
            <span class="branch-stem"></span>
            <span class="branch-bus"></span>
            <span class="branch-drop branch-drop-left"></span>
            <span class="branch-drop branch-drop-center"></span>
            <span class="branch-drop branch-drop-right"></span>
          </div>

          <div class="architecture-row architecture-three">
            <div class="arch-node">
              <span>ВЫЧИСЛЕНИЯ</span>
              <strong>Кластер виртуализации</strong>
              <small>
                Proxmox VE · HA
              </small>
            </div>

            <div class="arch-node">
              <span>ХРАНЕНИЕ</span>
              <strong>Общее хранилище</strong>
              <small>
                Ceph · NAS
              </small>
            </div>

            <div class="arch-node">
              <span>РЕЗЕРВНОЕ КОПИРОВАНИЕ</span>
              <strong>Выделенная система резервного копирования</strong>
              <small>
                PBS · политики хранения
              </small>
            </div>
          </div>

          <div class="connector"></div>

          <div class="architecture-row architecture-three">
            <div class="arch-node">
              <span>ИДЕНТИФИКАЦИЯ</span>
              <strong>Каталог и DNS</strong>
              <small>
                Active Directory · DNS
              </small>
            </div>

            <div class="arch-node">
              <span>СЕРВИСЫ</span>
              <strong>Платформа сервисов</strong>
              <small>
                Инфраструктурные сервисы
              </small>
            </div>

            <div class="arch-node">
              <span>ЭКСПЛУАТАЦИЯ</span>
              <strong>Мониторинг и поддержка</strong>
              <small>
                Документация · эксплуатация
              </small>
            </div>
          </div>
        </div>
      </section>

      <section class="section section-dark">
        <div class="container">
          <div class="section-number">
            04 / РЕАЛИЗАЦИЯ
          </div>

          <div class="delivery">
            <article>
              <span>01</span>
              <h3>Физическая инфраструктура</h3>
              <p>
                Сметы на оборудование, схема сети, требования к кабельной
                инфраструктуре, подбор подрядчиков и контроль выполнения.
              </p>
            </article>

            <article>
              <span>02</span>
              <h3>Развёртывание платформы</h3>
              <p>
                Сегментация сети, виртуализация, общее хранилище, резервное
                копирование и инфраструктурные сервисы.
              </p>
            </article>

            <article>
              <span>03</span>
              <h3>Интеграция</h3>
              <p>
                Новая инфраструктура была интегрирована с существующими
                бизнес-системами и специализированными сервисами,
                а не развёрнута как изолированная среда.
              </p>
            </article>

            <article>
              <span>04</span>
              <h3>Миграция</h3>
              <p>
                Существующие сервисы и рабочие нагрузки были перенесены
                в новую среду с приоритетом на непрерывность эксплуатации.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section container">
        <div class="section-number">
          05 / ЭКСПЛУАТАЦИЯ
        </div>

        <div class="two-column">
          <h2>
            Реализация проекта не закончилась после запуска систем.
          </h2>

          <div class="copy">
            <p>
              Финальный этап включал техническую документацию,
              эксплуатационные процедуры и переход от проектного
              внедрения к штатной поддержке.
            </p>

            <p>
              Цель состояла не просто в том, чтобы инфраструктура заработала
              в день запуска, а в создании среды, которую можно понимать,
              мониторить, сопровождать и развивать.
            </p>
          </div>
        </div>
      </section>

      <section class="result">
        <div class="container result-grid">
          <span class="section-number">
            06 / РЕЗУЛЬТАТ
          </span>

          <h2>
            Сопровождаемая
          production-платформа
          вместо набора
          разрозненных систем.
          </h2>

          <p>
            Проект вырос из узкой технической задачи в полноценное
          развёртывание инфраструктуры. Результатом стала структурированная
          среда с понятными уровнями сети, виртуализации, хранения данных,
          идентификации, резервного копирования и эксплуатации.
          </p>

          <a href="/#projects">
            ← Назад к проектам
          </a>
        </div>
      </section>
    </main>
  <SiteFooter lang="ru" />

<style is:global>
      :root {
        color-scheme: dark;

        --bg: #0b0f14;
        --surface: #121920;
        --surface-2: #151e27;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.15);

        --text: #f2f5f7;
        --muted: #9aa7b4;
        --muted-strong: #c1cad3;

        --blue: #5b8cff;
        --cyan: #52d3c5;

        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;

        color: var(--text);

        background:
          linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          var(--bg);

        background-size: 48px 48px;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(
          calc(100% - 48px),
          var(--container)
        );

        margin-inline: auto;
      }

      .page-glow {
        position: fixed;
        z-index: -1;
        top: -250px;
        right: -200px;

        width: 600px;
        height: 600px;

        border-radius: 50%;

        background: var(--blue);

        opacity: 0.08;
        filter: blur(150px);
      }

      .hero {
        padding-block: 92px 110px;
      }

      .back {
        display: inline-block;

        margin-bottom: 72px;

        color: var(--muted);

        font-size: 12px;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns:
          minmax(0, 1.2fr)
          minmax(320px, 0.8fr);

        gap: 90px;
      }

      .index,
      .section-number {
        display: block;

        margin-bottom: 22px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 10px;
        letter-spacing: 0.13em;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 690px;

        margin-bottom: 30px;

        font-size:
          clamp(52px, 7vw, 82px);

        line-height: 0.96;
        letter-spacing: -0.055em;
      }

      h1 span {
        display: block;

        color: var(--muted);

        font-weight: 500;
      }

      .lead {
        max-width: 720px;

        margin-bottom: 0;

        color: var(--muted-strong);

        font-size: 18px;
        line-height: 1.7;
      }

      .summary {
        align-self: end;

        border-top:
          1px solid var(--border-strong);
      }

      .summary > div {
        display: flex;
        flex-direction: column;
        gap: 6px;

        padding: 17px 0;

        border-bottom:
          1px solid var(--border);
      }

      .summary span {
        color: var(--muted);
        font-size: 10px;
      }

      .summary strong {
        font-size: 12px;
      }

      .metrics {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .metrics-grid {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);
      }

      .metric {
        display: flex;
        min-height: 140px;

        flex-direction: column;
        justify-content: center;

        padding: 30px;

        border-right:
          1px solid var(--border);
      }

      .metric:first-child {
        border-left:
          1px solid var(--border);
      }

      .metric strong {
        margin-bottom: 5px;

        font-size: 25px;
        letter-spacing: -0.035em;
      }

      .metric span {
        color: var(--muted);
        font-size: 11px;
      }

      .section {
        padding-block: 110px;
      }

      .section-dark {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .two-column h2,
      .result h2 {
        max-width: 650px;

        margin-bottom: 0;

        font-size:
          clamp(36px, 4.5vw, 54px);

        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .copy p,
      .architecture-heading p,
      .result p {
        color: var(--muted);

        font-size: 14px;
        line-height: 1.8;
      }

      .copy p:last-child {
        margin-bottom: 0;
      }

      .responsibility-grid {
        display: grid;
        grid-template-columns:
          1fr 1fr;

        border-top:
          1px solid var(--border);
      }

      .responsibility {
        display: flex;
        min-height: 92px;

        gap: 15px;
        align-items: center;

        padding: 18px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .responsibility span {
        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .responsibility strong {
        font-size: 12px;
      }

      .architecture-heading {
        align-items: end;

        margin-bottom: 52px;
      }

      .architecture-heading p {
        max-width: 420px;
        margin-bottom: 0;
      }

      .architecture {
        padding: 42px;

        border: 1px solid var(--border-strong);
        border-radius: 20px;

        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.03),
            transparent
          ),
          var(--surface);
      }

      .architecture-row {
        display: flex;
        justify-content: center;
      }

      .architecture-three {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);

        gap: 16px;
      }

      .arch-node {
        display: flex;

        min-height: 135px;

        flex-direction: column;
        justify-content: center;

        padding: 22px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        background:
          rgba(11,15,20,.65);
      }

      .arch-node.accent {
        width: min(100%, 500px);

        border-color:
          rgba(91,140,255,.35);

        background:
          rgba(91,140,255,.07);
      }

      .arch-node span {
        margin-bottom: 11px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
        letter-spacing: .11em;
      }

      .arch-node strong {
        margin-bottom: 7px;

        font-size: 15px;
      }

      .arch-node small {
        color: var(--muted);

        font-size: 11px;
      }

      .connector {
        width: 1px;
        height: 34px;

        margin-inline: auto;

        background:
          linear-gradient(
            var(--blue),
            rgba(91,140,255,.15)
          );
      }



      .delivery {
        display: grid;
        grid-template-columns:
          repeat(4, 1fr);

        border-top:
          1px solid var(--border);
        border-left:
          1px solid var(--border);
      }

      .delivery article {
        min-height: 270px;

        padding: 28px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .delivery article > span {
        display: block;

        margin-bottom: 65px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .delivery h3 {
        margin-bottom: 14px;

        font-size: 17px;
      }

      .delivery p {
        margin-bottom: 0;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.7;
      }

      .result {
        padding-block: 110px;

        border-top:
          1px solid var(--border);

        background:
          linear-gradient(
            135deg,
            rgba(91,140,255,.08),
            transparent 45%
          );
      }

      .result-grid {
        display: grid;
        grid-template-columns:
          0.35fr 1.4fr 0.75fr;

        gap: 55px;
        align-items: start;
      }

      .result p {
        margin-bottom: 0;
      }

      .result a {
        grid-column: 2;

        width: max-content;

        margin-top: 12px;

        color: var(--blue);

        font-size: 12px;
        font-weight: 700;
      }

      @media (max-width: 900px) {


        .hero-grid,
        .two-column,
        .result-grid {
          grid-template-columns: 1fr;
          gap: 45px;
        }

        .metrics-grid,
        .architecture-three {
          grid-template-columns: 1fr;
        }

        .metric {
          border-bottom:
            1px solid var(--border);
          border-left:
            1px solid var(--border);
        }

        .responsibility-grid {
          grid-template-columns: 1fr;
        }

        .delivery {
          grid-template-columns:
            repeat(2, 1fr);
        }

        .result a {
          grid-column: 1;
        }
      }

      @media (max-width: 640px) {
        .container {
          width:
            min(calc(100% - 30px), var(--container));
        }

        .hero {
          padding-block: 65px 80px;
        }

        .back {
          margin-bottom: 50px;
        }

        h1 {
          font-size:
            clamp(34px, 10.8vw, 48px);
          line-height: 1.02;
          overflow-wrap: anywhere;
        }

        .section {
          padding-block: 80px;
        }

        .architecture {
          padding: 16px;
        }

        .summary strong,
        .arch-node strong,
        .arch-node small {
          overflow-wrap: anywhere;
        }

        .delivery {
          grid-template-columns: 1fr;
        }


      }


      .branch-connector {
          position: relative;
          z-index: 3;
          width: 66.666%;
          height: 54px;
          margin-inline: auto;
        }

        .branch-stem {
          position: absolute;
          top: 0;
          left: 50%;
          width: 1px;
          height: 27px;
          background: rgba(91, 140, 255, 0.7);
        }

        .branch-bus {
          position: absolute;
          top: 26px;
          left: 0;
          right: 0;
          height: 1px;
          background: rgba(91, 140, 255, 0.55);
        }

        .branch-drop {
          position: absolute;
          top: 26px;
          width: 1px;
          height: 28px;
          background: rgba(91, 140, 255, 0.55);
        }

        .branch-drop-left {
          left: 0;
        }

        .branch-drop-center {
          left: 50%;
        }

        .branch-drop-right {
          right: 0;
        }

        @media (max-width: 900px) {
          .branch-connector {
            display: none;
          }
        }
    </style>
</BaseLayout>
