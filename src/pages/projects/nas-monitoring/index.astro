---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";

const responsibilities = [
  "SNMPv3 и профили доступа",
  "Vendor-specific MIB и IF-MIB",
  "Модули snmp_exporter",
  "Recording rules Prometheus",
  "ZFS и RAID health",
  "Capacity, IOPS и throughput",
  "Температуры и network telemetry",
  "Alerting и NOC-dashboard",
];

const outcomes = [
  { value: "2", label: "NAS-платформы разных поколений" },
  { value: "SNMPv3", label: "единый транспорт метрик" },
  { value: "1 экран", label: "операционная картина storage" },
];

const targetExample = [
  "- targets:",
  "    - 10.20.10.21",
  "  labels:",
  "    device: nas-truenas-01",
  "    vendor: ixsystems",
  "    role: storage",
  "    snmp_auth: truenas_v3",
  "    snmp_module: system,if_mib,truenas_core",
].join("\n");

const recordingExample = [
  "- record: storage:truenas:zpool_used_percent",
  "  expr: |",
  "    100 * truenas_zpool_used_units",
  "    / truenas_zpool_size_units",
].join("\n");

const healthExample = [
  "- alert: TrueNASZpoolNotOnline",
  "  expr: truenas_zpool_health != 0",
  "  for: 2m",
  "  labels:",
  "    severity: critical",
  "    category: storage",
].join("\n");

const rateExample = [
  "rate(truenas_zpool_read_bytes_total[5m])",
  "rate(truenas_zpool_write_bytes_total[5m])",
  "",
  "rate(ifHCInOctets{ifName=\"storage0\"}[5m])",
  "rate(ifHCOutOctets{ifName=\"storage0\"}[5m])",
].join("\n");
---

<BaseLayout
  title="Мониторинг NAS через SNMP Exporter — Tudor Shandrov"
  description="Практический кейс мониторинга legacy LenovoEMC NAS и TrueNAS CORE через SNMPv3, snmp_exporter, Prometheus, alerting и Grafana."
  lang="ru"
>
  <div class="page-glow"></div>
  <SiteHeader lang="ru" />

  <main>
    <section class="hero container">
      <a class="back" href="/#projects">← Проекты</a>

      <div class="hero-grid">
        <div>
          <span class="index">КЕЙС / 05</span>
          <h1>
            Мониторинг NAS
            <span>через SNMP Exporter.</span>
          </h1>
          <p class="lead">
            Legacy LenovoEMC и TrueNAS CORE сведены в одну эксплуатационную
            модель: SNMPv3, vendor-specific MIB, Prometheus recording rules,
            alerting и компактный Grafana dashboard для storage.
          </p>
        </div>

        <aside class="summary">
          <div>
            <span>Задача</span>
            <strong>Единый мониторинг разнородных NAS</strong>
          </div>
          <div>
            <span>Стек</span>
            <strong>SNMPv3 · snmp_exporter · Prometheus · Grafana</strong>
          </div>
          <div>
            <span>Фокус</span>
            <strong>Health · capacity · performance · network</strong>
          </div>
          <div>
            <span>Раскрытие данных</span>
            <strong>Адреса и внутренние имена обезличены</strong>
          </div>
        </aside>
      </div>
    </section>

    <section class="metrics">
      <div class="container metrics-grid">
        {outcomes.map((item) => (
          <div class="metric">
            <strong>{item.value}</strong>
            <span>{item.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section container">
      <div class="section-number">01 / КОНТЕКСТ</div>

      <div class="two-column">
        <h2>
          Разные поколения storage —
          одна задача эксплуатации.
        </h2>

        <div class="copy">
          <p>
            В одной инфраструктуре одновременно используются два NAS с
            принципиально разной внутренней моделью: аппаратный LenovoEMC
            с закрытой ОС и TrueNAS CORE с ZFS. Возможности телеметрии,
            названия OID и структура данных у них различаются.
          </p>

          <p>
            Целью было не просто получить несколько SNMP-значений, а привести
            обе платформы к единой эксплуатационной картине: доступность,
            заполнение, состояние RAID/ZFS, температуры, IOPS, throughput,
            сетевые интерфейсы и alerts.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">02 / ОТВЕТСТВЕННОСТЬ</div>

        <div class="two-column">
          <h2>
            От MIB и OID
            до понятного NOC-экрана.
          </h2>

          <div class="responsibility-grid">
            {responsibilities.map((item, index) => (
              <div class="responsibility">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{item}</strong>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">03 / АРХИТЕКТУРА</div>

      <div class="two-column architecture-heading">
        <h2>
          Vendor-specific сбор,
          единая модель выше.
        </h2>

        <p>
          Устройства опрашиваются разными SNMP-модулями, но после
          snmp_exporter данные попадают в один Prometheus и дальше
          обрабатываются одинаковыми operational-паттернами.
        </p>
      </div>

      <div class="architecture">
        <div class="architecture-row architecture-three">
          <div class="arch-node accent">
            <span>LEGACY NAS</span>
            <strong>LenovoEMC</strong>
            <small>HOST-RESOURCES-MIB · vendor MIB</small>
          </div>

          <div class="arch-node accent">
            <span>ZFS NAS</span>
            <strong>TrueNAS CORE</strong>
            <small>FREENAS-MIB · IF-MIB</small>
          </div>

          <div class="arch-node">
            <span>TRANSPORT</span>
            <strong>SNMPv3</strong>
            <small>Separate auth profiles</small>
          </div>
        </div>

        <div class="connector"></div>

        <div class="architecture-row architecture-three">
          <div class="arch-node">
            <span>COLLECT</span>
            <strong>snmp_exporter</strong>
            <small>Dedicated modules per platform</small>
          </div>

          <div class="arch-node">
            <span>NORMALIZE</span>
            <strong>Prometheus</strong>
            <small>Recording rules · alert rules</small>
          </div>

          <div class="arch-node">
            <span>OPERATE</span>
            <strong>Grafana · Alertmanager</strong>
            <small>NOC overview · actionable alerts</small>
          </div>
        </div>
      </div>

      <div class="note">
        TrueNAS использует SNMPv3 authPriv с SHA/AES. Для legacy NAS сохранён
        отдельный профиль, соответствующий возможностям устройства. Секреты
        не находятся в публичных конфигурациях и примерах.
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">04 / СБОР МЕТРИК</div>

        <div class="two-column">
          <h2>
            Собирать только то,
            что нужно эксплуатации.
          </h2>

          <div class="copy">
            <p>
              Для TrueNAS создан отдельный модуль на основе FREENAS-MIB:
              размеры и состояние ZFS pools, counters чтения и записи,
              ARC и температуры накопителей. Позже к target добавлен IF-MIB
              для состояния интерфейсов, traffic counters, errors и discards.
            </p>

            <p>
              Для LenovoEMC capacity берётся из HOST-RESOURCES-MIB, а RAID,
              физические диски, температуры и вентиляторы — из vendor-specific
              дерева. Полный SNMP walk в Prometheus не экспортируется:
              это уменьшает шум и cardinality.
            </p>
          </div>
        </div>

        <div class="code-grid">
          <div class="code-panel">
            <span>TRUENAS TARGET</span>
            <pre><code>{targetExample}</code></pre>
          </div>

          <div class="code-panel">
            <span>5-MINUTE RATES</span>
            <pre><code>{rateExample}</code></pre>
          </div>
        </div>

        <div class="signal-grid">
          <div class="signal-card">
            <strong>ZFS / RAID health</strong>
            <p>
              ONLINE/DEGRADED/FAULTED для ZFS и vendor-specific RAID/disk
              state для legacy NAS.
            </p>
          </div>

          <div class="signal-card">
            <strong>Capacity</strong>
            <p>
              Used, available, total и percentage с нормализацией
              allocation units в bytes.
            </p>
          </div>

          <div class="signal-card">
            <strong>Performance</strong>
            <p>
              Read/write throughput, IOPS, ARC, temperatures и сетевой
              RX/TX по активным интерфейсам.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">05 / НОРМАЛИЗАЦИЯ</div>

      <div class="two-column">
        <h2>
          Raw OID не должен
          определять Grafana.
        </h2>

        <div class="copy">
          <p>
            FREENAS-MIB передаёт размер pool через количество allocation units.
            Пересчёт в bytes и percentage вынесен в recording rules. Grafana
            и alerts работают уже с нормализованными метриками, а не повторяют
            vendor-specific формулы в каждой панели.
          </p>

          <p>
            Такой слой упрощает дальнейшую замену источника: меняется сбор
            или recording rule, а эксплуатационные dashboards и правила
            остаются стабильнее.
          </p>
        </div>
      </div>

      <div class="code-grid">
        <div class="code-panel">
          <span>RECORDING RULE</span>
          <pre><code>{recordingExample}</code></pre>
        </div>

        <div class="code-panel">
          <span>HEALTH ALERT</span>
          <pre><code>{healthExample}</code></pre>
        </div>
      </div>
    </section>

    <section class="section section-dark">
      <div class="container">
        <div class="section-number">06 / ALERTING</div>

        <div class="delivery">
          <article>
            <span>01</span>
            <h3>Availability</h3>
            <p>
              Потеря SNMP scrape контролируется независимо от визуализации.
            </p>
          </article>

          <article>
            <span>02</span>
            <h3>Storage health</h3>
            <p>
              Любое состояние ZFS pool кроме ONLINE и ненормальный RAID/disk
              state требуют реакции.
            </p>
          </article>

          <article>
            <span>03</span>
            <h3>Capacity</h3>
            <p>
              Уровни 80%, 90% и 95% разделяют warning, critical и almost-full
              сценарии.
            </p>
          </article>

          <article>
            <span>04</span>
            <h3>Temperature</h3>
            <p>
              HDD и NVMe имеют разные эксплуатационные пороги, чтобы
              не создавать ложные предупреждения.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section container">
      <div class="section-number">07 / DASHBOARD</div>

      <div class="two-column">
        <h2>
          Overview должен отвечать:
          «нужно ли действовать?»
        </h2>

        <div class="copy">
          <p>
            Первая версия dashboard содержала много исторических графиков и
            была технически подробной, но плохо читалась как NOC-экран.
            Финальная версия была перестроена вокруг текущего состояния.
          </p>

          <p>
            На одном экране размещены availability, alerts, температуры,
            ARC hit ratio, ZFS/RAID health, capacity, read/write throughput,
            IOPS, состояние сетевых интерфейсов, RX/TX и errors/discards.
            Детальная история при необходимости может жить в отдельном
            drill-down dashboard.
          </p>
        </div>
      </div>

      <div class="signal-grid">
        <div class="signal-card">
          <strong>Сверху</strong>
          <p>Availability · alerts · temperatures · ARC · interfaces.</p>
        </div>

        <div class="signal-card">
          <strong>В центре</strong>
          <p>Pool capacity · ZFS health · RAID · physical disks.</p>
        </div>

        <div class="signal-card">
          <strong>Ниже</strong>
          <p>Read/write · IOPS · network RX/TX · errors/discards.</p>
        </div>
      </div>
    </section>

    <section class="result">
      <div class="container result-grid">
        <span class="section-number">08 / РЕЗУЛЬТАТ</span>

        <h2>
          Две разные NAS-платформы —
          одна эксплуатационная картина.
        </h2>

        <p>
          Legacy appliance и TrueNAS сведены в единый monitoring pipeline
          без установки агентов на storage. Vendor-specific SNMP остаётся
          на уровне сбора, а выше используются нормализованные метрики,
          единые правила alerting и компактный Grafana overview.
        </p>

        <a href="/#projects">← Назад к проектам</a>
      </div>
    </section>
  </main>

  <SiteFooter lang="ru" />

<style is:global>
      :root {
        color-scheme: dark;

        --bg: #0b0f14;
        --surface: #121920;
        --surface-2: #151e27;
        --border: rgba(255, 255, 255, 0.09);
        --border-strong: rgba(255, 255, 255, 0.15);

        --text: #f2f5f7;
        --muted: #9aa7b4;
        --muted-strong: #c1cad3;

        --blue: #5b8cff;
        --cyan: #52d3c5;

        --container: 1180px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--bg);
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        min-width: 320px;

        color: var(--text);

        background:
          linear-gradient(
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px
          ),
          var(--bg);

        background-size: 48px 48px;

        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;

        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .container {
        width: min(
          calc(100% - 48px),
          var(--container)
        );

        margin-inline: auto;
      }

      .page-glow {
        position: fixed;
        z-index: -1;
        top: -250px;
        right: -200px;

        width: 600px;
        height: 600px;

        border-radius: 50%;

        background: var(--blue);

        opacity: 0.08;
        filter: blur(150px);
      }

      .hero {
        padding-block: 92px 110px;
      }

      .back {
        display: inline-block;

        margin-bottom: 72px;

        color: var(--muted);

        font-size: 12px;
      }

      .hero-grid,
      .two-column {
        display: grid;
        grid-template-columns:
          minmax(0, 1.2fr)
          minmax(320px, 0.8fr);

        gap: 90px;
      }

      .index,
      .section-number {
        display: block;

        margin-bottom: 22px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 10px;
        letter-spacing: 0.13em;
      }

      h1,
      h2,
      h3,
      p {
        margin-top: 0;
      }

      h1 {
        max-width: 690px;

        margin-bottom: 30px;

        font-size:
          clamp(52px, 7vw, 82px);

        line-height: 0.96;
        letter-spacing: -0.055em;
      }

      h1 span {
        display: block;

        color: var(--muted);

        font-weight: 500;
      }

      .lead {
        max-width: 720px;

        margin-bottom: 0;

        color: var(--muted-strong);

        font-size: 18px;
        line-height: 1.7;
      }

      .summary {
        align-self: end;

        border-top:
          1px solid var(--border-strong);
      }

      .summary > div {
        display: flex;
        flex-direction: column;
        gap: 6px;

        padding: 17px 0;

        border-bottom:
          1px solid var(--border);
      }

      .summary span {
        color: var(--muted);
        font-size: 10px;
      }

      .summary strong {
        font-size: 12px;
      }

      .metrics {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .metrics-grid {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);
      }

      .metric {
        display: flex;
        min-height: 140px;

        flex-direction: column;
        justify-content: center;

        padding: 30px;

        border-right:
          1px solid var(--border);
      }

      .metric:first-child {
        border-left:
          1px solid var(--border);
      }

      .metric strong {
        margin-bottom: 5px;

        font-size: 25px;
        letter-spacing: -0.035em;
      }

      .metric span {
        color: var(--muted);
        font-size: 11px;
      }

      .section {
        padding-block: 110px;
      }

      .section-dark {
        border-block:
          1px solid var(--border);

        background:
          rgba(255, 255, 255, 0.012);
      }

      .two-column h2,
      .result h2 {
        max-width: 650px;

        margin-bottom: 0;

        font-size:
          clamp(36px, 4.5vw, 54px);

        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      .copy p,
      .architecture-heading p,
      .result p {
        color: var(--muted);

        font-size: 14px;
        line-height: 1.8;
      }

      .copy p:last-child {
        margin-bottom: 0;
      }

      .responsibility-grid {
        display: grid;
        grid-template-columns:
          1fr 1fr;

        border-top:
          1px solid var(--border);
      }

      .responsibility {
        display: flex;
        min-height: 92px;

        gap: 15px;
        align-items: center;

        padding: 18px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .responsibility span {
        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .responsibility strong {
        font-size: 12px;
      }

      .architecture-heading {
        align-items: end;

        margin-bottom: 52px;
      }

      .architecture-heading p {
        max-width: 420px;
        margin-bottom: 0;
      }

      .architecture {
        padding: 42px;

        border: 1px solid var(--border-strong);
        border-radius: 20px;

        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.03),
            transparent
          ),
          var(--surface);
      }

      .architecture-row {
        display: flex;
        justify-content: center;
      }

      .architecture-three {
        display: grid;
        grid-template-columns:
          repeat(3, 1fr);

        gap: 16px;
      }

      .arch-node {
        display: flex;

        min-height: 135px;

        flex-direction: column;
        justify-content: center;

        padding: 22px;

        border:
          1px solid var(--border);

        border-radius: 12px;

        background:
          rgba(11,15,20,.65);
      }

      .arch-node.accent {
        width: min(100%, 500px);

        border-color:
          rgba(91,140,255,.35);

        background:
          rgba(91,140,255,.07);
      }

      .arch-node span {
        margin-bottom: 11px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
        letter-spacing: .11em;
      }

      .arch-node strong {
        margin-bottom: 7px;

        font-size: 15px;
      }

      .arch-node small {
        color: var(--muted);

        font-size: 11px;
      }

      .connector {
        width: 1px;
        height: 34px;

        margin-inline: auto;

        background:
          linear-gradient(
            var(--blue),
            rgba(91,140,255,.15)
          );
      }



      .delivery {
        display: grid;
        grid-template-columns:
          repeat(4, 1fr);

        border-top:
          1px solid var(--border);
        border-left:
          1px solid var(--border);
      }

      .delivery article {
        min-height: 270px;

        padding: 28px;

        border-right:
          1px solid var(--border);
        border-bottom:
          1px solid var(--border);
      }

      .delivery article > span {
        display: block;

        margin-bottom: 65px;

        color: var(--blue);

        font-family:
          ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;

        font-size: 9px;
      }

      .delivery h3 {
        margin-bottom: 14px;

        font-size: 17px;
      }

      .delivery p {
        margin-bottom: 0;

        color: var(--muted);

        font-size: 12px;
        line-height: 1.7;
      }

      .result {
        padding-block: 110px;

        border-top:
          1px solid var(--border);

        background:
          linear-gradient(
            135deg,
            rgba(91,140,255,.08),
            transparent 45%
          );
      }

      .result-grid {
        display: grid;
        grid-template-columns:
          0.35fr 1.4fr 0.75fr;

        gap: 55px;
        align-items: start;
      }

      .result p {
        margin-bottom: 0;
      }

      .result a {
        grid-column: 2;

        width: max-content;

        margin-top: 12px;

        color: var(--blue);

        font-size: 12px;
        font-weight: 700;
      }

      @media (max-width: 900px) {


        .hero-grid,
        .two-column,
