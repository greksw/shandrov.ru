---
interface Props {
  lang?: "ru" | "en";
}

const {
  lang = "en",
} = Astro.props;

const isRu = lang === "ru";

const privacyHref = isRu
  ? "/privacy/"
  : "/en/privacy/";
---

<footer class="site-footer">
  <div class="site-container site-footer-inner">
    <span>
      © {new Date().getFullYear()} Tudor Shandrov
    </span>

    <span>
      {
        isRu
          ? "Инженер инфраструктуры / Руководитель инфраструктуры"
          : "Infrastructure Engineer / Infrastructure Lead"
      }
    </span>

    <div class="site-footer-links">
      <a href={privacyHref}>
        {isRu ? "Конфиденциальность" : "Privacy"}
      </a>

      <span class="site-footer-separator">
        ·
      </span>

      <span>
        shandrov.ru
      </span>
    </div>
  </div>
</footer>
