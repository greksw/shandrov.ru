---
interface Props {
  lang?: "ru" | "en";
}

const {
  lang = "en",
} = Astro.props;

const isRu = lang === "ru";

const pathname = Astro.url.pathname;

const ruHref =
  pathname === "/en/"
    ? "/"
    : pathname.startsWith("/en/")
      ? pathname.slice(3)
      : pathname;

const enHref =
  pathname === "/"
    ? "/en/"
    : pathname.startsWith("/en/")
      ? pathname
      : `/en${pathname}`;

const homeHref = isRu ? "/" : "/en/";
const resumeHref = isRu ? "/resume/" : "/en/resume/";
const isResume = pathname === "/resume/" || pathname === "/en/resume/";

const labels = isRu
  ? {
      expertise: "Экспертиза",
      projects: "Проекты",
      about: "Обо мне",
      resume: "Резюме",
      notes: "Заметки",
      home: "Главная Tudor Shandrov",
    }
  : {
      expertise: "Expertise",
      projects: "Projects",
      about: "About",
      resume: "Resume",
      notes: "Notes",
      home: "Tudor Shandrov home",
    };
---

<header class="site-header">
  <div class="site-container site-nav">
    <a
      href={homeHref}
      class="site-brand"
      aria-label={labels.home}
    >
      <span class="site-brand-mark">TS</span>

      <span class="site-brand-name">
        Tudor Shandrov
      </span>
    </a>

    <nav
      class="site-nav-links"
      aria-label={isRu ? "Основная навигация" : "Main navigation"}
    >
      <a href={`${homeHref}#expertise`}>
        {labels.expertise}
      </a>

      <a href={`${homeHref}#projects`}>
        {labels.projects}
      </a>

      <a href={`${homeHref}#about`}>
        {labels.about}
      </a>

      <a
        href={resumeHref}
        aria-current={isResume ? "page" : undefined}
        class:list={{ active: isResume }}
      >
        {labels.resume}
      </a>

      <a
        href="https://notes.shandrov.ru"
        target="_blank"
        rel="noreferrer"
      >
        {labels.notes}
      </a>
    </nav>

    <div class="site-nav-actions">
      <div
        class="site-language"
        aria-label={isRu ? "Выбор языка" : "Language selection"}
      >
        <a
          href={ruHref}
          aria-current={isRu ? "page" : undefined}
          class:list={{ active: isRu }}
        >
          RU
        </a>

        <span aria-hidden="true">/</span>

        <a
          href={enHref}
          aria-current={!isRu ? "page" : undefined}
          class:list={{ active: !isRu }}
        >
          EN
        </a>
      </div>

      <a
        class="site-github-link"
        href="https://github.com/greksw"
        target="_blank"
        rel="noreferrer"
      >
        GitHub
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>
